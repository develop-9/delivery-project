# hub-service 환경변수
#
# 이 파일을 복사해서 .env 로 만들고 값을 채운다.
#   cp .env.example .env
# .env 는 gitignore 대상이므로 커밋되지 않는다.
#
# 로컬 실행 시 host 는 localhost, 컨테이너 실행 시 서비스명(postgres / redis / eureka-server) 을 쓴다.

# ===== Database =====
HUB_DB_URL=
HUB_DB_USERNAME=
HUB_DB_PASSWORD=

# ===== Redis =====
HUB_REDIS_HOST=
HUB_REDIS_PORT=

# ===== Eureka =====
EUREKA_SERVER_URL=

# ===== JWT =====
# 게이트웨이가 relay 한 토큰을 파싱하기 위한 키.
# 팀 전체가 동일한 값을 써야 한다. 값이 다르면 인증이 전부 실패한다.
JWT_SECRET_KEY=

# ===== 네이버 지도 Directions 5 API =====
# 허브 간 거리·소요시간 자동 산출에 사용 (설계 결정 D8)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
