# hub-service 가 참조하는 환경변수
#
# 값은 저장소 루트의 .env 에 넣는다. 다른 서비스와 같은 파일을 공유한다.
#   cp .env.example ../.env   (이미 있으면 아래 항목만 추가)
# 루트 .env 는 gitignore 대상이므로 커밋되지 않는다.
#
# DB·Redis·Eureka 는 application.yaml 에 로컬 기본값이 있어
# 값을 비워둬도 로컬 실행은 된다. 컨테이너 실행 시 host 는
# docker-compose-service.yaml 의 environment 가 서비스명으로 덮어쓴다.

# ===== Database =====
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# ===== Redis =====
REDIS_HOST=
REDIS_PORT=

# ===== Eureka =====
EUREKA_SERVER_URL=

# ===== JWT =====
# 게이트웨이가 relay 한 토큰을 파싱하기 위한 키.
# 팀 전체가 동일한 값을 써야 한다. 값이 다르면 인증이 전부 실패한다.
JWT_SECRET_KEY=

# ===== 네이버 지도 Directions 5 API =====
# 허브 간 거리·소요시간 자동 산출에 사용 (설계 결정 D8)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
