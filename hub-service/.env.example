# hub-service 가 참조하는 환경변수
#
# 값은 저장소 루트의 .env 에 넣는다. 다른 서비스와 같은 파일을 공유한다.
# 루트 .env 는 gitignore 대상이라 커밋되지 않는다.
#
# 주의: application.yaml 에 기본값이 있는 키(${VAR:기본값})를 빈 값으로 두지 않는다.
# 기본값은 "키가 없을 때"만 적용된다. VAR= 처럼 비워두면 빈 문자열이 그대로 들어가
# jdbc:postgresql://:5432/... 같은 값이 되어 기동이 깨진다. 쓰지 않을 키는 아예 적지 않는다.
#
# 접속 주소(host)는 여기에 적지 않는다.
#   컨테이너 실행 : docker-compose-service.yaml 의 environment 가 컨테이너 기준 값으로 덮어쓴다
#   호스트 실행   : application.yaml 의 기본값(localhost)이 적용된다

# ===== Database =====
# infra compose 의 postgres 컨테이너를 만들 때도 쓰이므로 값이 반드시 있어야 한다.
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# 5432 가 이미 점유돼 있어 postgres 를 다른 호스트 포트로 띄운 경우에만 주석을 푼다.
# 컨테이너끼리는 항상 5432 로 통신하므로 compose 가 이 값을 덮어쓴다.
#POSTGRES_PORT=5433

# ===== JWT =====
# 게이트웨이가 relay 한 토큰을 파싱하기 위한 키.
# 팀 전체가 동일한 값을 써야 한다. 값이 다르면 인증이 전부 실패한다.
#
# 키 이름은 토큰을 발급하는 user-service 가 읽는 것과 같아야 한다 (JWT_SECRET).
# HMAC-SHA256 이라 32바이트 이상이어야 하고, 짧거나 비어 있으면 기동 시점에 실패한다.
JWT_SECRET=

# ===== 네이버 지도 Directions 5 API =====
# 허브 간 거리·소요시간 자동 산출(설계 결정 D8)에 쓸 키.
# 아직 연동하지 않아 값을 읽는 코드가 없다. 거리·시간은 API 요청으로 직접 받는다.
#NAVER_MAP_CLIENT_ID=
#NAVER_MAP_CLIENT_SECRET=
