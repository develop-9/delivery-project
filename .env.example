# DB는 delivery_db 하나만 쓰고 서비스별로 스키마를 나눈다
# 서비스 구분은 각 서비스 application.yaml의 hibernate.default_schema가 한다.
POSTGRES_DB=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# 인증된 행위자가 없는 상태에서 생성되는 행(회원가입 등)의 created_by/updated_by에 쓰는
# 팀 공통 시스템 주체 ID. 전 서비스가 같은 값을 써야 한다.
SYSTEM_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

SLACK_BOT_TOKEN=
SLACK_API_URL=https://slack.com/api/chat.postMessage

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Access Token 서명 시크릿. User Service(발급)와 API Gateway(검증)가 같은 값을 써야 한다.
JWT_SECRET=
# Refresh Token 서명 시크릿. User Service만 쓴다(Gateway는 Access Token만 다뤄서 필요 없음)
# Access Token 시크릿과 노출 범위가 달라서 일부러 분리했다, JWT_SECRET과 다른 값으로 채울 것.
JWT_REFRESH_SECRET=
