# DB는 delivery_db 하나만 쓰고 서비스별로 스키마를 나눈다.
# 서비스 구분은 각 서비스 application.yaml의 hibernate.default_schema가 한다.
POSTGRES_DB=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# 인증된 행위자가 없는 상태에서 생성되는 행의 created_by/updated_by에 쓰는
# 팀 공통 시스템 주체 ID. 전 서비스가 같은 값을 사용한다.
SYSTEM_ID=

# Gemini 생성형 AI API
# 실제 API Key는 .env에만 입력하고 .env.example에는 작성하지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com