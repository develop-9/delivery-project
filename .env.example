# DB 는 delivery_db 하나만 쓰고 서비스별로 스키마({서비스}_schema)를 나눈다.
# 서비스 구분은 각 서비스 application.yaml 의 hibernate.default_schema 가 한다.
# 전 서비스가 이 값을 공유하므로 서비스마다 다르게 두면 안 된다.
POSTGRES_DB=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# 인증된 행위자가 없는 상태에서 생성되는 행(회원가입 등)의 created_by/updated_by에 쓰는
# 팀 공통 시스템 주체 ID. 전 서비스가 같은 값을 써야 한다.
SYSTEM_ID=
